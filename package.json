{
  "name": "campus-kit",
  "version": "0.1.0",
  "description": "An accessible HTML/CSS design system and page-template kit for small college and nonprofit websites, built entirely by AI.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "serve": "http-server . -p 8080 -c-1 --silent",
    "build": "node scripts/includes.mjs",
    "check:includes": "node scripts/includes.mjs --check",
    "lint:html": "html-validate \"*.html\" \"demo/**/*.html\"",
    "test:a11y": "node tests/accessibility.mjs",
    "test:zoom": "node tests/zoom.mjs",
    "test": "npm run check:includes && npm run lint:html && npm run test:a11y && npm run test:zoom",
    "test:lighthouse": "lhci collect && lhci assert"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.14.0",
    "html-validate": "^9.0.0",
    "http-server": "^14.1.1",
    "playwright": "^1.48.0"
  }
}
